# Secrets and personal values live in ~/.config/airlock, never here. These
# patterns are the safety net in case one lands in the repo anyway.
.env
.env.*
*.local.*
/secrets/

target/
node_modules/
dist/
dist-laptop/
/app/gen/
/app/permissions/autogenerated/
test-results/
playwright-report/
/.claude/worktrees/
