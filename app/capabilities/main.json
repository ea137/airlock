{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What Airlock's window may do: the hub's admin calls, its own terminals, and hearing the hub's events.",
  "windows": ["main"],
  "permissions": [
    "allow-terminals",
    "allow-sessions",
    "allow-session",
    "allow-history",
    "allow-terminal-record",
    "allow-delete-terminal-record",
    "allow-session-record",
    "allow-delete-session-record",
    "allow-open-terminal",
    "allow-terminal-input",
    "allow-terminal-resize",
    "allow-close-terminal",
    "allow-open-in-terminal-app",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-pairings",
    "allow-approve",
    "allow-deny",
    "allow-devices",
    "allow-revoke",
    "allow-activity",
    "allow-changes",
    "allow-change",
    "allow-apply-change",
    "allow-decline-change",
    "allow-settings",
    "allow-save-settings"
  ]
}
