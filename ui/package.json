{
  "name": "airlock-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Airlock's web UI, for the phone and the laptop app. Built into the hub.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode laptop",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p e2e --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && cargo build --manifest-path ../Cargo.toml && playwright test"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/major-mono-display": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@tauri-apps/api": "2.12.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "highlight.js": "11.12.0",
    "svelte": "5.57.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
